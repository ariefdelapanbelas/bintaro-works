# Salin menjadi .env lalu sesuaikan
DATABASE_URL="postgresql://bwos:bwos@localhost:5432/bwos?schema=public"

# Kunci rahasia untuk menandatangani sesi login (min. 32 karakter acak)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# Opsional: paksa cookie Secure ("true"/"false"). Kosongkan = otomatis sesuai http/https.
COOKIE_SECURE=""

# Tampilkan akun contoh di halaman login (hanya untuk lokal/demo; JANGAN di produksi)
NEXT_PUBLIC_DEMO_MODE="true"

# ---------------------------------------------------------------
# Login dengan akun sosial (opsional — kosongkan bila belum dipakai)
# Tombolnya otomatis muncul begitu pasangan ID + SECRET terisi.
# Alamat callback yang harus didaftarkan di masing-masing konsol:
#   https://DOMAIN-ANDA/api/auth/oauth/google/callback
#   https://DOMAIN-ANDA/api/auth/oauth/facebook/callback
#   https://DOMAIN-ANDA/api/auth/oauth/tiktok/callback
# ---------------------------------------------------------------

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta for Developers → app → Facebook Login → Settings
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Opsional: versi Graph API (default v25.0)
FACEBOOK_GRAPH_VERSION=""

# TikTok for Developers → app → Login Kit (memakai client key, bukan client id)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Alamat publik aplikasi — dipakai menyusun URL callback bila server di balik proxy.
# Contoh: https://app.bintaroworks.id
APP_URL=""
