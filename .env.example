# Salin menjadi .env lalu sesuaikan
DATABASE_URL="postgresql://bwos:bwos@localhost:5432/bwos?schema=public"

# Kunci rahasia untuk menandatangani sesi login (min. 32 karakter acak)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# Opsional: paksa cookie Secure ("true"/"false"). Kosongkan = otomatis sesuai http/https.
COOKIE_SECURE=""

# Tampilkan akun contoh di halaman login (hanya untuk lokal/demo; JANGAN di produksi)
NEXT_PUBLIC_DEMO_MODE="true"
